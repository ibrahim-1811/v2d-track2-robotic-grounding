# Apptainer translation of official/video_to_data/robotic_grounding/flash_chord/docker/Dockerfile
# at 193382a (target stage "dev"). Same base, same apt packages, same uv / Python pins,
# same `uv sync --frozen --extra train --extra dev` from the checked-in lock.
#
# Build (from the repo root):
#   apptainer build --fakeroot containers/flash_chord.sif cluster/flash_chord.def
#
# At run time the upstream flash_chord checkout is bind-mounted over /workspace,
# exactly as docker/run.sh does, so the baked copy only seeds the venv.
Bootstrap: docker
From: nvidia/cuda:13.0.2-devel-ubuntu24.04

%files
    official/video_to_data/robotic_grounding/flash_chord /workspace

%environment
    export UV_LINK_MODE=copy
    export UV_PYTHON_INSTALL_DIR=/opt/uv/python
    export VIRTUAL_ENV=/opt/venv
    export PATH="/opt/venv/bin:${PATH}"
    export NVIDIA_VISIBLE_DEVICES=all
    export NVIDIA_DRIVER_CAPABILITIES=all
    export PYTHONPATH=/workspace/src

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y --no-install-recommends \
        libglvnd0 libgl1 libglx0 libegl1 libgles2 libopengl0 \
        libglu1-mesa libosmesa6 libglfw3 \
        libx11-6 libxext6 libxrender1 libxi6 libxrandr2 libxcursor1 \
        libxinerama1 libxfixes3 libxxf86vm1 libxkbcommon0 libxcb1 \
        fontconfig libfreetype6 \
        git curl ca-certificates xvfb
    rm -rf /var/lib/apt/lists/*

    # uv 0.11.21, the Dockerfile's UV_TAG
    curl -fsSL https://github.com/astral-sh/uv/releases/download/0.11.21/uv-x86_64-unknown-linux-gnu.tar.gz \
        | tar xz -C /tmp
    install -m 0755 /tmp/uv-x86_64-unknown-linux-gnu/uv /tmp/uv-x86_64-unknown-linux-gnu/uvx /bin/

    export UV_LINK_MODE=copy UV_COMPILE_BYTECODE=1 UV_PYTHON_INSTALL_DIR=/opt/uv/python \
           VIRTUAL_ENV=/opt/venv PATH="/opt/venv/bin:${PATH}" UV_CACHE_DIR=/tmp/uv-cache
    uv python install 3.11.15
    uv venv --python 3.11.15 /opt/venv

    cd /workspace
    uv sync --active --frozen --extra train --extra dev
    python -c "import hydra, omegaconf; assert hydra.__version__ == '1.3.2'"
    rm -rf /tmp/uv-cache
    chmod -R a+rX /opt/venv /opt/uv

%runscript
    exec "$@"
